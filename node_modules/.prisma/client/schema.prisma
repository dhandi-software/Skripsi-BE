generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int              @id @default(autoincrement())
  username           String           @unique
  password           String
  role               String
  isBannedFromPublic Boolean          @default(false)
  acaras             Acara[]
  acaraComments      AcaraComment[]
  adminOfRooms       ChatRoom[]       @relation("RoomAdmin")
  chatMemberships    ChatRoomMember[]
  dosen              Dosen?
  downloads          Download[]
  mahasiswa          Mahasiswa?
  receivedMessages   Message[]        @relation("ReceivedMessages")
  sentMessages       Message[]        @relation("SentMessages")
  staf               Staf?
  deletedMessages    Message[]        @relation("DeletedBy")
}

model Mahasiswa {
  nim                String               @id @unique
  userId             Int                  @unique
  nama               String
  tahunMasuk         String?
  nomorTelepon       String?
  email              String?              @unique
  photo              String?
  acaraReadStatus    AcaraReadStatus[]
  bimbingan          Bimbingan[]
  logbook            Logbook[]
  user               User                 @relation(fields: [userId], references: [id])
  pengajuanJudul     PengajuanJudul[]
  penilaian          Penilaian[]
  sanksiAdministrasi SanksiAdministrasi[]
  sidang             Sidang[]
  tempatKP           TempatKP[]
}

model Dosen {
  nidn               String               @id @unique
  nip                String?              @unique
  userId             Int                  @unique
  nama               String
  jabatan            String
  nomorTelepon       String?
  email              String?              @unique
  photo              String?
  peminatan          String[]             @default([])
  acara              Acara[]
  bimbingan          Bimbingan[]
  user               User                 @relation(fields: [userId], references: [id])
  download           Download[]
  pengajuanJudul     PengajuanJudul[]
  penilaian          Penilaian[]
  sanksiAdministrasi SanksiAdministrasi[]
  sidang             Sidang[]
}

model Download {
  id          Int      @id @default(autoincrement())
  dosenNidn   String
  userId      Int?
  title       String
  description String?
  fileUrl     String
  fileType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dosen       Dosen    @relation(fields: [dosenNidn], references: [nidn])
  user        User?    @relation(fields: [userId], references: [id])
}

model Staf {
  nip          String     @id @unique
  userId       Int        @unique
  nama         String
  nomorTelepon String?
  email        String?    @unique
  photo        String?
  user         User       @relation(fields: [userId], references: [id])
  jadwalKp     JadwalKp[]
}

model Penilaian {
  id            Int       @id @default(autoincrement())
  mahasiswaNim  String
  dosenNidn     String
  p1_k1         Float?
  p1_k2         Float?
  p1_k3         Float?
  p1_total      Float?
  p1_nama       String?
  p2_k1         Float?
  p2_k2         Float?
  p2_k3         Float?
  p2_total      Float?
  p2_nama       String?
  nilaiRataRata Float?
  keterangan    String?
  tanggal       DateTime  @default(now())
  dosen         Dosen     @relation(fields: [dosenNidn], references: [nidn])
  mahasiswa     Mahasiswa @relation(fields: [mahasiswaNim], references: [nim])
}

model Bimbingan {
  id                Int                   @id @default(autoincrement())
  mahasiswaNim      String
  dosenNidn         String
  topik             String
  catatan           String
  status            String
  fileMahasiswa     String?
  fileDosen         String?
  keteranganProgres String?
  jadwalBimbingan   DateTime?
  versi             Int                   @default(1)
  isReadDosen       Boolean               @default(false)
  parentId          Int?
  tanggal           DateTime              @default(now())
  dosen             Dosen                 @relation(fields: [dosenNidn], references: [nidn])
  mahasiswa         Mahasiswa             @relation(fields: [mahasiswaNim], references: [nim])
  parent            Bimbingan?            @relation("BimbinganHistory", fields: [parentId], references: [id])
  children          Bimbingan[]           @relation("BimbinganHistory")
  anotasi           BimbinganAnnotation[]
}

model BimbinganAnnotation {
  id          Int       @id @default(autoincrement())
  bimbinganId Int
  komentar    String
  warna       String    @default("#FFFF00")
  posisi      Json
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  bimbingan   Bimbingan @relation(fields: [bimbinganId], references: [id], onDelete: Cascade)
}

model Message {
  id             Int       @id @default(autoincrement())
  content        String?
  attachmentUrl  String?
  attachmentType String?
  fileName       String?
  senderId       Int
  receiverId     Int?
  roomId         Int?
  isPublic       Boolean   @default(false)
  isRead         Boolean   @default(false)
  readByIds      Int[]     @default([])
  isDeleted      Boolean   @default(false)
  isEdited       Boolean   @default(false)
  replyToId      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  receiver       User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  parent         Message?  @relation("ReplyTo", fields: [replyToId], references: [id])
  children       Message[] @relation("ReplyTo")
  room           ChatRoom? @relation(fields: [roomId], references: [id])
  sender         User      @relation("SentMessages", fields: [senderId], references: [id])
  deletedBy      User[]    @relation("DeletedBy")
}

model ChatRoom {
  id        Int              @id @default(autoincrement())
  name      String
  adminId   Int
  isGroup   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  admin     User             @relation("RoomAdmin", fields: [adminId], references: [id])
  members   ChatRoomMember[]
  messages  Message[]
}

model ChatRoomMember {
  id       Int      @id @default(autoincrement())
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model PengajuanJudul {
  id             Int       @id @default(autoincrement())
  mahasiswaNim   String
  dosenNidn      String
  judul          String
  peminatan      String
  semester       String
  tahunAkademik  String
  sksDicapai     String
  sksNilaiD      String
  ipk            String
  batasStudi     String
  status         String    @default("PENDING")
  remarks        String?
  deadlineRevisi DateTime?
  tanggal        DateTime  @default(now())
  dosen          Dosen     @relation(fields: [dosenNidn], references: [nidn])
  mahasiswa      Mahasiswa @relation(fields: [mahasiswaNim], references: [nim])
}

model Sidang {
  id                 Int       @id @default(autoincrement())
  mahasiswaNim       String
  dosenNidn          String
  pengujiNidn        String?
  judul              String?
  tanggalSidang      DateTime?
  waktuSidang        String?
  lokasi             String?
  status             String    @default("MENUNGGU_PERSETUJUAN_PEMBIMBING")
  pembimbingApproved Boolean   @default(false)
  mahasiswaSeen      Boolean   @default(false)
  catatan            String?
  suratTugasUrl      String?
  laporanUrl         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  dosen              Dosen     @relation(fields: [dosenNidn], references: [nidn])
  mahasiswa          Mahasiswa @relation(fields: [mahasiswaNim], references: [nim])
}

model Acara {
  id        Int               @id @default(autoincrement())
  dosenNidn String
  userId    Int?
  title     String
  content   String
  type      String            @default("ASSIGNMENT")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  dosen     Dosen             @relation(fields: [dosenNidn], references: [nidn])
  user      User?             @relation(fields: [userId], references: [id])
  comments  AcaraComment[]
  readBy    AcaraReadStatus[]
}

model AcaraComment {
  id        Int      @id @default(autoincrement())
  acaraId   Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  acara     Acara    @relation(fields: [acaraId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model AcaraReadStatus {
  id           Int       @id @default(autoincrement())
  acaraId      Int
  mahasiswaNim String
  readAt       DateTime  @default(now())
  acara        Acara     @relation(fields: [acaraId], references: [id], onDelete: Cascade)
  mahasiswa    Mahasiswa @relation(fields: [mahasiswaNim], references: [nim], onDelete: Cascade)

  @@unique([acaraId, mahasiswaNim])
}

model TempatKP {
  id               Int        @id @default(autoincrement())
  namaPerusahaan   String?
  tlpFaxPerusahaan String?
  alamatPerusahaan String?
  kontakPembimbing String?
  mahasiswaNim     String?
  mahasiswa        Mahasiswa? @relation(fields: [mahasiswaNim], references: [nim], onDelete: Cascade)
}

model Logbook {
  id              Int        @id @default(autoincrement())
  mahasiswaNim    String?
  tanggalPukul    DateTime
  uraian          String
  mahasiswaParaf  String?
  pembimbingParaf String?
  catatan         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  mahasiswa       Mahasiswa? @relation(fields: [mahasiswaNim], references: [nim], onDelete: Cascade)
}

model SanksiAdministrasi {
  id            Int       @id @default(autoincrement())
  mahasiswaNim  String
  dosenNidn     String
  nama          String
  nim           String
  hariSidang    String
  tanggalSidang String
  hariTenggat   String
  tanggalSurat  String
  status        String    @default("Menunggu Hardcover")
  tenggatWaktu  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  dosen         Dosen     @relation(fields: [dosenNidn], references: [nidn], onDelete: Cascade)
  mahasiswa     Mahasiswa @relation(fields: [mahasiswaNim], references: [nim], onDelete: Cascade)
}

model JadwalKp {
  id        Int      @id @default(autoincrement())
  tipe      String
  judul     String
  deskripsi String?
  tanggal   DateTime
  stafNip   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staf      Staf     @relation(fields: [stafNip], references: [nip])
}
