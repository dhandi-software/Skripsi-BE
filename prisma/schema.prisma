generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int              @id @default(autoincrement())
  username           String           @unique @db.VarChar(255)
  password           String @db.VarChar(255)
  role               String @db.VarChar(255)
  isBannedFromPublic Boolean          @default(false)
  acaras             Acara[]
  acaraComments      AcaraComment[]
  adminOfRooms       ChatRoom[]       @relation("RoomAdmin")
  chatMemberships    ChatRoomMember[]
  dosen              Dosen?
  downloads          Download[]
  mahasiswa          Mahasiswa?
  receivedMessages   Message[]        @relation("ReceivedMessages")
  sentMessages       Message[]        @relation("SentMessages")
  staf               Staf?
  deletedMessages    Message[]        @relation("DeletedBy")
}

model Mahasiswa {
  nim                String               @id @unique @db.VarChar(255)
  userId             Int                  @unique
  nama               String @db.VarChar(255)
  tahunMasuk         String? @db.VarChar(255)
  nomorTelepon       String? @db.VarChar(255)
  email              String?              @unique @db.VarChar(255)
  photo              String? @db.VarChar(255)
  acaraReadStatus    AcaraReadStatus[]
  bimbingan          Bimbingan[]
  logbook            Logbook[]
  user               User                 @relation(fields: [userId], references: [id])
  pengajuanJudul     PengajuanJudul[]
  penilaian          Penilaian[]
  sanksiAdministrasi SanksiAdministrasi[]
  sidang             Sidang[]
  tempatKP           TempatKP[]
}

model Dosen {
  nidn               String               @id @unique @db.VarChar(255)
  nip                String?              @unique @db.VarChar(255)
  userId             Int                  @unique
  nama               String               @db.VarChar(255)
  jabatan            String               @db.VarChar(255)
  nomorTelepon       String?              @db.VarChar(255)
  email              String?              @unique @db.VarChar(255)
  photo              String?              @db.VarChar(255)
  peminatan          String[]             @default([]) @db.VarChar(255)
  acara              Acara[]
  bimbingan          Bimbingan[]
  user               User                 @relation(fields: [userId], references: [id])
  download           Download[]
  pengajuanJudul     PengajuanJudul[]
  penilaian          Penilaian[]
  sanksiAdministrasi SanksiAdministrasi[]
  sidang             Sidang[]
}

model Download {
  id          Int      @id @default(autoincrement())
  dosenNidn   String @db.VarChar(255)
  userId      Int?
  title       String @db.VarChar(255)
  description String?
  fileUrl     String @db.VarChar(255)
  fileType    String @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dosen       Dosen    @relation(fields: [dosenNidn], references: [nidn])
  user        User?    @relation(fields: [userId], references: [id])
}

model Staf {
  nip          String   @id @unique @db.VarChar(255)
  userId       Int      @unique
  nama         String @db.VarChar(255)
  nomorTelepon String? @db.VarChar(255)
  email        String?  @unique @db.VarChar(255)
  photo        String? @db.VarChar(255)
  user         User       @relation(fields: [userId], references: [id])
  jadwalKp     JadwalKp[]
}

model Penilaian {
  id            Int       @id @default(autoincrement())
  mahasiswaNim  String @db.VarChar(255)
  dosenNidn     String @db.VarChar(255)
  p1_k1         Float?
  p1_k2         Float?
  p1_k3         Float?
  p1_total      Float?
  p1_nama       String? @db.VarChar(255)
  p2_k1         Float?
  p2_k2         Float?
  p2_k3         Float?
  p2_total      Float?
  p2_nama       String? @db.VarChar(255)
  nilaiRataRata Float?
  keterangan    String? @db.VarChar(255)
  tanggal       DateTime  @default(now())
  dosen         Dosen     @relation(fields: [dosenNidn], references: [nidn])
  mahasiswa     Mahasiswa @relation(fields: [mahasiswaNim], references: [nim])
}

model Bimbingan {
  id                Int                   @id @default(autoincrement())
  mahasiswaNim      String @db.VarChar(255)
  dosenNidn         String @db.VarChar(255)
  topik             String @db.VarChar(255)
  catatan           String
  status            String @db.VarChar(255)
  fileMahasiswa     String? @db.VarChar(255)
  fileDosen         String? @db.VarChar(255)
  keteranganProgres String?
  jadwalBimbingan   DateTime?
  versi             Int                   @default(1)
  isReadDosen       Boolean               @default(false)
  parentId          Int?
  tanggal           DateTime              @default(now())
  dosen             Dosen                 @relation(fields: [dosenNidn], references: [nidn])
  mahasiswa         Mahasiswa             @relation(fields: [mahasiswaNim], references: [nim])
  parent            Bimbingan?            @relation("BimbinganHistory", fields: [parentId], references: [id])
  children          Bimbingan[]           @relation("BimbinganHistory")
  anotasi           BimbinganAnnotation[]
}

model BimbinganAnnotation {
  id          Int       @id @default(autoincrement())
  bimbinganId Int
  komentar    String
  warna       String    @default("#FFFF00") @db.VarChar(255)
  posisi      Json
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  bimbingan   Bimbingan @relation(fields: [bimbinganId], references: [id], onDelete: Cascade)
}

model Message {
  id             Int       @id @default(autoincrement())
  content        String?
  attachmentUrl  String? @db.VarChar(255)
  attachmentType String? @db.VarChar(255)
  fileName       String? @db.VarChar(255)
  senderId       Int
  receiverId     Int?
  roomId         Int?
  isPublic       Boolean   @default(false)
  isRead         Boolean   @default(false)
  readByIds      Int[]     @default([])
  isDeleted      Boolean   @default(false)
  isEdited       Boolean   @default(false)
  replyToId      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  receiver       User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  parent         Message?  @relation("ReplyTo", fields: [replyToId], references: [id])
  children       Message[] @relation("ReplyTo")
  room           ChatRoom? @relation(fields: [roomId], references: [id])
  sender         User      @relation("SentMessages", fields: [senderId], references: [id])
  deletedBy      User[]    @relation("DeletedBy")
}

model ChatRoom {
  id        Int              @id @default(autoincrement())
  name      String @db.VarChar(255)
  adminId   Int
  isGroup   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  admin     User             @relation("RoomAdmin", fields: [adminId], references: [id])
  members   ChatRoomMember[]
  messages  Message[]
}

model ChatRoomMember {
  id       Int      @id @default(autoincrement())
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model PengajuanJudul {
  id            Int       @id @default(autoincrement())
  mahasiswaNim  String @db.VarChar(255)
  dosenNidn     String @db.VarChar(255)
  judul         String @db.VarChar(255)
  peminatan     String @db.VarChar(255)
  semester      String @db.VarChar(255)
  tahunAkademik String @db.VarChar(255)
  sksDicapai    String @db.VarChar(255)
  sksNilaiD     String @db.VarChar(255)
  ipk           String @db.VarChar(255)
  batasStudi    String @db.VarChar(255)
  status        String    @default("PENDING") @db.VarChar(255)
  remarks       String? @db.VarChar(255)
  deadlineRevisi DateTime?
  tanggal       DateTime  @default(now())
  dosen         Dosen     @relation(fields: [dosenNidn], references: [nidn])
  mahasiswa     Mahasiswa @relation(fields: [mahasiswaNim], references: [nim])
}

model Sidang {
  id                 Int       @id @default(autoincrement())
  mahasiswaNim       String @db.VarChar(255)
  dosenNidn          String @db.VarChar(255)
  pengujiNidn        String? @db.VarChar(255)
  judul              String? @db.VarChar(255)
  tanggalSidang      DateTime?
  waktuSidang        String? @db.VarChar(255)
  lokasi             String? @db.VarChar(255)
  status             String    @default("MENUNGGU_PERSETUJUAN_PEMBIMBING") @db.VarChar(255)
  pembimbingApproved Boolean   @default(false)
  mahasiswaSeen      Boolean   @default(false)
  catatan            String?
  suratTugasUrl      String? @db.VarChar(255)
  laporanUrl         String? @db.VarChar(255)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  dosen              Dosen     @relation(fields: [dosenNidn], references: [nidn])
  mahasiswa          Mahasiswa @relation(fields: [mahasiswaNim], references: [nim])
}

model Acara {
  id        Int               @id @default(autoincrement())
  dosenNidn String @db.VarChar(255)
  userId    Int?
  title     String @db.VarChar(255)
  content   String
  type      String            @default("ASSIGNMENT") @db.VarChar(255)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  dosen     Dosen             @relation(fields: [dosenNidn], references: [nidn])
  user      User?             @relation(fields: [userId], references: [id])
  comments  AcaraComment[]
  readBy    AcaraReadStatus[]
}

model AcaraComment {
  id        Int      @id @default(autoincrement())
  acaraId   Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  acara     Acara    @relation(fields: [acaraId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model AcaraReadStatus {
  id           Int       @id @default(autoincrement())
  acaraId      Int
  mahasiswaNim String @db.VarChar(255)
  readAt       DateTime  @default(now())
  acara        Acara     @relation(fields: [acaraId], references: [id], onDelete: Cascade)
  mahasiswa    Mahasiswa @relation(fields: [mahasiswaNim], references: [nim], onDelete: Cascade)

  @@unique([acaraId, mahasiswaNim])
}

model TempatKP {
  id               Int        @id @default(autoincrement())
  namaPerusahaan   String? @db.VarChar(255)
  tlpFaxPerusahaan String? @db.VarChar(255)
  alamatPerusahaan String?
  kontakPembimbing String? @db.VarChar(255)
  mahasiswaNim     String? @db.VarChar(255)
  mahasiswa        Mahasiswa? @relation(fields: [mahasiswaNim], references: [nim], onDelete: Cascade)
}

model Logbook {
  id              Int        @id @default(autoincrement())
  mahasiswaNim    String? @db.VarChar(255)
  tanggalPukul    DateTime
  uraian          String
  mahasiswaParaf  String?
  pembimbingParaf String?
  catatan         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  mahasiswa       Mahasiswa? @relation(fields: [mahasiswaNim], references: [nim], onDelete: Cascade)
}

model SanksiAdministrasi {
  id            Int       @id @default(autoincrement())
  mahasiswaNim  String @db.VarChar(255)
  dosenNidn     String @db.VarChar(255)
  nama          String @db.VarChar(255)
  nim           String @db.VarChar(255)
  hariSidang    String @db.VarChar(255)
  tanggalSidang String @db.VarChar(255)
  hariTenggat   String @db.VarChar(255)
  tanggalSurat  String @db.VarChar(255)
  status        String    @default("Menunggu Hardcover") @db.VarChar(255)
  tenggatWaktu  DateTime?
  tanggalKonfirmasi DateTime?
  denda             Int       @default(0)
  keterlambatanMinggu Int     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  dosen         Dosen     @relation(fields: [dosenNidn], references: [nidn], onDelete: Cascade)
  mahasiswa     Mahasiswa @relation(fields: [mahasiswaNim], references: [nim], onDelete: Cascade)
}

model JadwalKp {
  id             Int      @id @default(autoincrement())
  tipe           String @db.VarChar(255)
  judul          String @db.VarChar(255)
  deskripsi      String?
  tanggal        DateTime
  stafNip        String @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  staf           Staf     @relation(fields: [stafNip], references: [nip])
}
